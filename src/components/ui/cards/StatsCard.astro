---
// Stats Card
// ------------
// Description: A statistics card component to display numerical data with a label
// Properties:
// - number: the main statistic number
// - label: the description/label for the statistic
// - suffix: optional suffix for the number (e.g., %, +, k)
// - classes: extra classes

// Components
import Card from './partials/Card.astro'
import CardBody from './partials/CardBody.astro'

// Props
type Props = {
	number: string | number
	label: string
	suffix?: string
	classes?: string
}
const { number, label, suffix = '', classes } = Astro.props
---

<Card classes={`text-center !border-0 !shadow-none ${classes}`}>
	<CardBody>
		<div class="stats-number">
			{number}{suffix && <span class="stats-suffix">{suffix}</span>}
		</div>
		<p class="stats-label">{label}</p>
	</CardBody>
</Card>

<style>
	.stats-number {
		@apply mb-2 text-4xl font-bold text-primary-500 lg:text-5xl;
	}
	.stats-suffix {
		@apply text-3xl lg:text-4xl;
	}
	.stats-label {
		@apply text-sm font-medium text-neutral-600 lg:text-base;
	}
</style>
