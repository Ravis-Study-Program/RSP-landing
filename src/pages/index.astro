---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import PricingFAQ from '../components/blocks/FAQ/PricingFAQ.astro'
import Features from '../components/blocks/features/FeatureCards.astro'
import Hero from '../components/blocks/hero/HomeCTA.astro'

// Content
// - Testimonial background
import CompaniesList from '../components/blocks/companies/CompaniesList.astro'

// - SEO
const SEO = {
	title: "Ravi's Study Program - Free intensive coding bootcamp",
	description:
		"Ravi's Study Program is a free intensive coding bootcamp that helps students land their big tech FAANG companies within 3 months.	"
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<CompaniesList />
	<Features />
	<PricingFAQ />
</Layout>
