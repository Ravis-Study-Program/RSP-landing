---
import companiesData from '../../../data/json-files/companiesData.json'
import Col from '../../ui/Col.astro'
import Row from '../../ui/Row.astro'
import Section from '../../ui/Section.astro'
import CompanyFeature from './CompanyFeature.astro'
---

<Section id="companies" padding="top" classes="bg-neutral-50">
	<Row>
		<Col span="12">
			<CompanyFeature
				title="Our Alumni Network"
				text="Our graduates have secured software engineering internship and graduate positions at FAANG, Big Tech and leading high-frequency trading firms worldwide."
				data={companiesData}
				classes="mb-24"
			/>
		</Col>
	</Row>
</Section>
