---
// Pricing FAQ component
// ------------
// Description: A dedicated FAQ component for pricing questions

// Components
import FAQ from './FaqSticky.astro'

// Data
import faqData from '../../../data/json-files/faqData.json'
import Section from '../../ui/Section.astro'

// Filter FAQ data for pricing category
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="faq" classes="bg-neutral-50">
	<FAQ
		title="Frequently Asked Questions"
		text="Got questions? We've got answers. Explore our FAQs to learn more about how everything works."
		data={faqPricing}
		classes={classes}
	/>
</Section>
